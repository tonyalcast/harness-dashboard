# Optional. Enables the unofficial Cursor adapter.
# Never commit the real value. The cookie is never logged, stored, or returned by the API.
CURSOR_SESSION_COOKIE=

# Optional. Enables reading your real Claude subscription usage (the numbers
# behind claude.ai/settings/usage and the /usage command).
#
# How to fill these in yourself — never paste these values into a chat:
#   1. Open https://claude.ai/settings/usage while logged in
#   2. DevTools → Application → Cookies → https://claude.ai → copy the
#      `sessionKey` value into CLAUDE_SESSION_COOKIE
#   3. DevTools → Network → click Refresh on that page → the request goes to
#      /api/organizations/<ORG_ID>/usage → copy that <ORG_ID> into CLAUDE_ORG_ID
#
# Undocumented endpoint: it can break without notice. The cookie is never
# logged, written to SQLite, or returned by any API route.
CLAUDE_SESSION_COOKIE=
CLAUDE_ORG_ID=

# Optional path overrides
# CLAUDE_PROJECTS_DIR=
# OPENCODE_DATA_DIR=
