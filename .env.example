# Subscription cookies — optional. You can set the same values here or in the
# dashboard under Settings → Subscription cookies (saved to ~/.harness-dashboard/secrets.json).
#
# Optional. Enables the unofficial Cursor adapter + spending reader
# (https://cursor.com/dashboard/spending — Included / Other Models / On-Demand).
#
# How to fill this in yourself — never paste the value into a chat:
#   1. Open https://cursor.com/dashboard/spending while logged in
#   2. DevTools → Application → Cookies → https://cursor.com → copy the
#      `WorkosCursorSessionToken` value into CURSOR_SESSION_COOKIE
#
# Undocumented endpoints; they can break without notice. The cookie is never
# logged, written to SQLite, or returned by any API route.
CURSOR_SESSION_COOKIE=

# Optional. Enables reading your real Claude subscription usage (the numbers
# behind claude.ai/settings/usage and the /usage command).
#
# How to fill these in yourself — never paste these values into a chat:
#   1. Open https://claude.ai/settings/usage while logged in
#   2. DevTools → Application → Cookies → https://claude.ai → copy the
#      `sessionKey` value into CLAUDE_SESSION_COOKIE
#   3. DevTools → Network → click Refresh on that page → the request goes to
#      /api/organizations/<ORG_ID>/usage → copy that <ORG_ID> into CLAUDE_ORG_ID
#
# Undocumented endpoint: it can break without notice. The cookie is never
# logged, written to SQLite, or returned by any API route.
CLAUDE_SESSION_COOKIE=
CLAUDE_ORG_ID=

# Optional. Enables reading your OpenCode Go subscription meters
# (Continuous / Weekly / Monthly) from https://opencode.ai/workspace/<id>/go.
#
# How to fill these in yourself — never paste these values into a chat:
#   1. Open your Go workspace while logged in
#   2. Copy the workspace id from the URL:
#      https://opencode.ai/workspace/<OPENCODE_GO_WORKSPACE_ID>/go
#   3. DevTools → Application → Cookies → https://opencode.ai → copy the
#      `auth` cookie value into OPENCODE_GO_AUTH_COOKIE
#
# Undocumented page scrape; it can break without notice. The cookie is never
# logged, written to SQLite, or returned by any API route.
OPENCODE_GO_WORKSPACE_ID=
OPENCODE_GO_AUTH_COOKIE=

# Optional path overrides
# CLAUDE_PROJECTS_DIR=
# OPENCODE_DATA_DIR=
